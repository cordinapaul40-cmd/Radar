# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app (pour le lien de connexion par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chiffrement des clés API des utilisateurs : openssl rand -base64 32
RADAR_ENCRYPTION_KEY=

# Secret de la tâche hebdomadaire (Vercel l'envoie automatiquement)
CRON_SECRET=
